<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.XinlizixunDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.XinlizixunEntity" id="xinlizixunMap">
        <result property="zixunmingcheng" column="zixunmingcheng"/>
        <result property="zixunfenlei" column="zixunfenlei"/>
        <result property="fengmiantupian" column="fengmiantupian"/>
        <result property="zixunfeiyong" column="zixunfeiyong"/>
        <result property="kaifangshijian" column="kaifangshijian"/>
        <result property="zixunjieshao" column="zixunjieshao"/>
        <result property="zixunxiangqing" column="zixunxiangqing"/>
        <result property="zixunshizhanghao" column="zixunshizhanghao"/>
        <result property="zixunshixingming" column="zixunshixingming"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.XinlizixunVO" >
		SELECT * FROM xinlizixun  xinlizixun         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.XinlizixunVO" >
		SELECT  xinlizixun.* FROM xinlizixun  xinlizixun 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.XinlizixunView" >

		SELECT  xinlizixun.* FROM xinlizixun  xinlizixun 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.XinlizixunView" >
		SELECT * FROM xinlizixun  xinlizixun <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

    <select id="selectValue" resultType="map" >
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM xinlizixun
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.xColumn}
    </select>

    <select id="selectTimeStatValue" resultType="map" >
        <if test = 'params.timeStatType == "日"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM xinlizixun
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM xinlizixun
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test = 'params.timeStatType == "年"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM xinlizixun
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map" >
        SELECT ${params.column} , count(1) total FROM xinlizixun
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.column}
    </select>




</mapper>
